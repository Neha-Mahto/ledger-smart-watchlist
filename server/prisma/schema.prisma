datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String            @id @default(uuid())
  username         String            @unique
  themePreference  String            @default("dark")
  createdAt        DateTime          @default(now())
  watchlists       WatchlistItem[]
  alerts           PriceAlert[]
  lastSeenSnapshot LastSeenSnapshot?
}

model WatchlistItem {
  id        String   @id @default(uuid())
  userId    String
  symbol    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
}

model PriceAlert {
  id          String   @id @default(uuid())
  userId      String
  symbol      String
  targetPrice Float
  direction   String   // 'ABOVE' | 'BELOW'
  triggered   Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LastSeenSnapshot {
  id           String   @id @default(uuid())
  userId       String   @unique
  snapshotData String   // JSON string storing baseline prices & stats
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AttentionEvent {
  id             String   @id @default(uuid())
  symbol         String
  attentionScore Int
  reason         String
  price          Float
  changePercent  Float
  volumeSurge    Float
  createdAt      DateTime @default(now())
}
